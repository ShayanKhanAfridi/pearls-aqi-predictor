# Copy this file to .env and fill in your values
# Never commit .env to Git

# Get your API key from: https://app.hopsworks.ai → Account Settings → API Keys
HOPSWORKS_API_KEY=your_hopsworks_api_key_here

# Hopsworks cluster host (default is eu-west, change if using a different region)
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai

# Local folder where Hopsworks stores TLS certificates (auto-created at runtime)
HOPSWORKS_CERT_FOLDER=.hopsworks_certs
